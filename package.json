{
  "name": "jira-issues",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "./scripts/check-design-tokens.py && npm run build -w server && npm run build -w web",
    "typecheck": "./scripts/check-design-tokens.py && npm run typecheck -w server && npm run typecheck -w web",
    "test": "npm run test -w web",
    "sync-ds": "./scripts/sync-design-system.sh",
    "db:reset": "npm run db:reset -w server",
    "db:generate": "npm run db:generate -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
