{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:reset": "rm -rf data && echo 'database removed; it is recreated and seeded on next start'",
    "db:generate": "node --disable-warning=ExperimentalWarning --import tsx src/db/generate-test-data.ts"
  },
  "dependencies": {
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
